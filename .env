# ==== JagX Bot Environment Variables ====

# MongoDB connection string (Atlas free tier works fine)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/jagxbot?retryWrites=true&w=majority

# The WhatsApp number the bot will run on (with country code, no + or spaces)
# e.g. 2348012345678
BOT_NUMBER=2348012345678

# Owner number(s), comma separated, no + (used for owner-only commands)
OWNER_NUMBERS=2348012345678

# Command prefix (default: .)
PREFIX=.

# Bot display name
BOT_NAME=JagX

# Port for the small web server (pairing page + health check) - Render sets this automatically
PORT=3000

# Optional: public URL of your deployed site, shown in the pairing page
PUBLIC_URL=https://your-app.onrender.com

